# Aiera MCP Server Environment Configuration

# Required: Your Aiera API key
AIERA_API_KEY=your-aiera-api-key-here

# Optional: Deployment stage (dev, staging, prod)
STAGE=dev

# Optional: AWS region for deployment
AWS_REGION=us-east-1

# Optional: Custom S3 bucket for SAM deployments
SAM_S3_BUCKET=

# Optional: Lambda configuration
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=30

# Optional: Debug settings
DEBUG=false
LOG_LEVEL=INFO